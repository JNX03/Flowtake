{
  "$schema": "https://raw.githubusercontent.com/nicoulaj/tauri-docs/refs/heads/v2/tooling/cli/schema.json",
  "productName": "Flowtake",
  "version": "1.2.0",
  "identifier": "com.flowtake.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Flowtake",
        "label": "main",
        "url": "index.html",
        "width": 1000,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost http://video.localhost blob: data: stream:; connect-src 'self' https: http: ws: wss: ipc: asset: http://asset.localhost http://video.localhost; font-src 'self' data:; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "binaries/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "libx11-6", "libxcb1", "libxrandr2", "libpulse0", "xdotool", "wmctrl"],
        "postInstallScript": "scripts/linux-postinstall.sh"
      },
      "rpm": {
        "depends": ["ffmpeg", "libX11", "libxcb", "libXrandr", "pulseaudio-libs", "xdotool", "wmctrl"],
        "postInstallScript": "scripts/linux-postinstall.sh"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "externalBin": [
      "binaries/ffmpeg"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {}
  }
}
