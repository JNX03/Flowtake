{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Flowtake",
  "version": "1.4.1",
  "identifier": "com.flowtake.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Flowtake",
        "label": "main",
        "url": "index.html",
        "width": 1000,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true,
        "devtools": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost http://image.localhost blob: data:; media-src 'self' asset: http://asset.localhost http://video.localhost blob: data: stream:; connect-src 'self' https: wss: ipc: asset: http://asset.localhost http://video.localhost; font-src 'self' data:; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage", "rpm"],
    "publisher": "Jnx03",
    "copyright": "Copyright (c) 2025-present Jnx03",
    "shortDescription": "Screen recorder with automatic zoom animations",
    "longDescription": "Flowtake is a professional screen recording application that automatically adds zoom and pan animations to your recordings. Record your screen, edit with auto-zoom effects, and export production-ready videos in minutes.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "binaries/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "../resources/setup.ico",
        "installerHooks": "nsis-hooks.nsh",
        "installMode": "both",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "libx11-6", "libxcb1", "libxrandr2", "libpulse0", "xdotool", "wmctrl"],
        "postInstallScript": "scripts/linux-postinstall.sh"
      },
      "rpm": {
        "depends": ["ffmpeg", "libX11", "libxcb", "libXrandr", "pulseaudio-libs", "xdotool", "wmctrl"],
        "postInstallScript": "scripts/linux-postinstall.sh"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "externalBin": [
      "binaries/ffmpeg"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {}
  }
}
